{
  "description": "context-guard: warn when the session's live context grows large enough to bloat every turn's upload",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/warn-context.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
